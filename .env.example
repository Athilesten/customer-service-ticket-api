# Set these in the shell or use a process manager to load them.
TICKET_DEBUG=0
TICKET_ALLOWED_HOSTS=127.0.0.1,localhost
TICKET_LOG_LEVEL=INFO
TICKET_DB_BACKEND=sqlite
TICKET_SLA_WARNING_MINUTES=60
TICKET_SLA_URGENT_RESPONSE_HOURS=1
TICKET_SLA_URGENT_RESOLUTION_HOURS=4
TICKET_SLA_HIGH_RESPONSE_HOURS=2
TICKET_SLA_HIGH_RESOLUTION_HOURS=8
TICKET_SLA_NORMAL_RESPONSE_HOURS=4
TICKET_SLA_NORMAL_RESOLUTION_HOURS=24
TICKET_SLA_LOW_RESPONSE_HOURS=8
TICKET_SLA_LOW_RESOLUTION_HOURS=72

